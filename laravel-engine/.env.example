APP_NAME=ICRHK
APP_ENV=production
APP_KEY=base64:PASTE_A_GENERATED_32_BYTE_KEY_HERE
# Must match CER_ENCRYPTION_KEY in wp-config.php for shared registration PII encryption.
CER_ENCRYPTION_KEY=
# Must match CER_TICKET_CALLBACK_SECRET in wp-config.php. Used only for Laravel-to-WordPress ticket delivery callbacks.
CER_TICKET_CALLBACK_SECRET=
APP_DEBUG=false
APP_URL=https://your-domain.example/laravel-engine/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Laravel-owned tables: use a database available to this cPanel account.
DB_DATABASE=your_laravel_database
DB_USERNAME=your_laravel_database_user
DB_PASSWORD=replace-with-laravel-database-password

# WordPress database. Laravel reads the wp_evt_* tables from this connection.
WP_DB_HOST=127.0.0.1
WP_DB_PORT=3306
WP_DB_DATABASE=your_cpanel_database
WP_DB_USERNAME=your_cpanel_database_user
WP_DB_PASSWORD=replace-with-database-password
WP_DB_PREFIX=wp_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack configuration. Keep credentials only in the untracked .env file.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENV=live
PAYSTACK_CURRENCY=KES
WORDPRESS_URL=http://localhost/icrhk
# Public HTTPS endpoint configured in the Paystack dashboard:
# https://usable-paltry-cameo.ngrok-free.dev/laravel-engine/public/api/paystack-webhook
