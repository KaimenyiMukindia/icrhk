# Local environment secrets.
.env
wp-config.php
laravel-engine/.env

# Runtime state, caches, logs, and backup-plugin output.
wp-content/ai1wm-backups/
wp-content/aiowps_backups/
wp-content/jetpack-waf/
wp-content/litespeed/
wp-content/logs/
wp-content/maintenance/
wp-content/wflogs/
wp-content/wpvivid_staging/
